# Copy to functions/.env (not committed). Non-secret settings only.
# google | libretranslate | disabled   ("disabled" simulates a provider outage: messages still send, UI shows retry)
TRANSLATION_PROVIDER=google
# Only for libretranslate (your own instance), e.g. https://translate.example.com
LIBRETRANSLATE_URL=
# Must match your Realtime Database region: us-central1 (default), europe-west1 or asia-southeast1
NH_FUNCTIONS_REGION=us-central1
# Only when your database is not the default instance, e.g. my-project-default-rtdb
NH_DB_INSTANCE=
