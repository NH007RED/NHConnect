{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && query.orderByChild === 'usernameLower' && query.limitToFirst <= 50",
      ".indexOn": ["usernameLower"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['displayName', 'username', 'usernameLower', 'country', 'language', 'createdAt'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,20}$/) && (!data.exists() || data.val() === newData.val())" },
        "usernameLower": { ".validate": "newData.isString() && newData.val() === newData.parent().child('username').val().toLowerCase() && (!data.exists() || data.val() === newData.val()) && root.child('usernames').child(newData.val()).val() === $uid" },
        "country": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)" },
        "language": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,3}(-[A-Za-z]{2,4})?$/)" },
        "photoUrl": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
        "photoVer": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "createdAt": { ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()" },
        "$other": { ".validate": false }
      }
    },

    "userPhotos": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['data', 'updatedAt'])",
        "data": { ".validate": "newData.isString() && newData.val().length <= 90000" },
        "updatedAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "chatMedia": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "$messageId": {
          ".write": "auth != null && auth.token.email_verified === true && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && root.child('chats').child($chatId).child('messages').child($messageId).child('messageType').val() === 'image' && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['data', 'w', 'h'])",
          "data": { ".validate": "newData.isString() && newData.val().length <= 420000" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20000" },
          "h": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20000" },
          "$other": { ".validate": false }
        }
      }
    },

    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && !root.child('users').child(auth.uid).exists()) || (data.val() === auth.uid && !newData.exists() && !root.child('users').child(auth.uid).exists()))",
        ".validate": "newData.isString() && $name.matches(/^[a-z0-9_]{3,20}$/)"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "metadata": { ".write": false },
        "messages": {
          "$messageId": {
            ".write": "auth != null && auth.token.email_verified === true && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && ((!data.exists() && newData.child('senderId').val() === auth.uid) || (data.exists() && data.child('senderId').val() === auth.uid && newData.exists()))",
            ".validate": "newData.hasChildren(['senderId', 'recipientId', 'originalText', 'createdAt', 'messageType', 'translationStatus', 'sourceLanguage', 'targetLanguage'])",
            "senderId": { ".validate": "newData.val() === auth.uid || newData.val() === data.val()" },
            "recipientId": { ".validate": "newData.isString() && newData.val() !== auth.uid && newData.val() === ($chatId.beginsWith(auth.uid + '_') ? $chatId.replace(auth.uid + '_', '') : $chatId.replace('_' + auth.uid, '')) && (data.exists() || (root.child('users').child(newData.val()).exists() && !root.child('userBlocks').child(newData.val()).child(auth.uid).exists()))" },
            "originalText": { ".validate": "newData.isString() && (newData.parent().child('deleted').val() === true ? newData.val() === '' : ((newData.parent().child('messageType').val() === 'image' || newData.parent().child('messageType').val() === 'file') ? newData.val().length <= 4000 : (newData.val().length > 0 && newData.val().length <= 4000))) && (!data.parent().child('deleted').exists() || newData.val() === data.val())" },
            "sourceLanguage": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,3}(-[A-Za-z]{2,4})?$/)" },
            "targetLanguage": { ".validate": "(newData.isString() && newData.val().matches(/^[a-z]{2,3}(-[A-Za-z]{2,4})?$/) && !data.exists()) || newData.val() === data.val()" },
            "messageType": { ".validate": "(newData.val() === 'text' || newData.val() === 'image' || newData.val() === 'file') && (!data.exists() || newData.val() === data.val())" },
            "mediaThumb": { ".validate": "newData.isString() && newData.val().length <= 8000 && newData.parent().child('messageType').val() === 'image' && (!data.exists() || newData.val() === data.val())" },
            "mediaW": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20000 && (!data.exists() || newData.val() === data.val())" },
            "fileName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200 && newData.parent().child('messageType').val() === 'file' && (!data.exists() || newData.val() === data.val())" },
            "fileSize": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000 && (!data.exists() || newData.val() === data.val())" },
            "fileMime": { ".validate": "newData.isString() && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())" },
            "mediaH": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20000 && (!data.exists() || newData.val() === data.val())" },
            "createdAt": { ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())" },
            "editedAt": { ".validate": "newData.isNumber() && newData.val() === now && data.parent().exists()" },
            "deleted": { ".validate": "newData.val() === true && data.parent().exists()" },
            "replyToMessageId": { ".validate": "newData.isString() && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())" },
            "translationStatus": { ".validate": "newData.isString() && ((!data.exists() && newData.val() === 'pending') || newData.val() === data.val())" },
            "translatedText": { ".validate": "newData.val() === data.val()" },
            "translationProvider": { ".validate": "newData.val() === data.val()" },
            "translationError": { ".validate": "newData.val() === data.val()" },
            "translationUpdatedAt": { ".validate": "newData.val() === data.val()" },
            "detectedLanguage": { ".validate": "newData.val() === data.val()" },
            "processedAt": { ".validate": "newData.val() === data.val()" },
            "reactions": {
              "$reactor": {
                ".write": "auth != null && auth.token.email_verified === true && auth.uid === $reactor && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
                ".validate": "newData.isString() && newData.val().length <= 8"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "messageReceipts": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "$messageId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && root.child('chats').child($chatId).child('messages').child($messageId).child('recipientId').val() === auth.uid",
            "deliveredAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
            "readAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "translationRequests": {
      "$chatId": {
        "$messageId": {
          ".write": "auth != null && auth.token.email_verified === true && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && root.child('chats').child($chatId).child('messages').child($messageId).child('recipientId').val() === auth.uid",
          ".validate": "newData.hasChildren(['requestedBy', 'requestedAt'])",
          "requestedBy": { ".validate": "newData.val() === auth.uid" },
          "requestedAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "p2pInbox": {
      "$target": {
        ".read": "auth != null && auth.uid === $target",
        "$id": {
          ".write": "auth != null && ((auth.uid === $target && !newData.exists()) || (!data.exists() && auth.token.email_verified === true && newData.child('by').val() === auth.uid && (newData.child('chatId').val().beginsWith(auth.uid + '_') || newData.child('chatId').val().endsWith('_' + auth.uid)) && newData.child('chatId').val().replace(auth.uid + '_', '').replace('_' + auth.uid, '') === $target && root.child('chats').child(newData.child('chatId').val()).child('messages').child(newData.child('messageId').val()).child('senderId').val() === $target && root.child('chats').child(newData.child('chatId').val()).child('messages').child(newData.child('messageId').val()).child('messageType').val() === 'file'))",
          ".validate": "newData.hasChildren(['chatId', 'messageId', 'sid', 'by', 'at'])",
          "chatId": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "messageId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "sid": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "p2p": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        ".write": "auth != null && auth.token.email_verified === true && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "$sid": {
          "offer": { ".validate": "newData.hasChildren(['t', 's']) && newData.child('s').val().length <= 30000 && newData.child('t').val().length <= 20" },
          "answer": { ".validate": "newData.hasChildren(['t', 's']) && newData.child('s').val().length <= 30000 && newData.child('t').val().length <= 20" },
          "error": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "ice": {
            "$role": {
              ".validate": "$role === 's' || $role === 'r'",
              "$cid": { ".validate": "newData.hasChildren(['c']) && newData.child('c').val().length <= 3000" }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
          ".validate": "newData.val() === true"
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          "favorite": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isBoolean()" },
          "muted": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isBoolean()" },
          "unreadCount": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.val() === 0" }
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "userBlocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$blocked": { ".validate": "newData.val() === true" }
      }
    },

    "userSettings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "notificationsEnabled": { ".validate": "newData.isBoolean()" },
        "notificationPreview": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "deviceTokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$token": { ".validate": "newData.val() === true && $token.length < 400" }
      }
    },

    "reports": {
      "$reportId": {
        ".write": "auth != null && !data.exists() && newData.child('reporterId').val() === auth.uid",
        ".validate": "newData.hasChildren(['reporterId', 'reportedUid', 'reason', 'createdAt'])",
        "reporterId": { ".validate": "newData.val() === auth.uid" },
        "reportedUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "chatId": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "translationCache": { ".indexOn": ["at"] }
  }
}
